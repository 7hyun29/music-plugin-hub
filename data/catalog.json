    "NativeAccess",
    "Native Access",
    "NTKDaemon"
  ],
  "patterns": [
    {
      "regex": "^WaveShell",
      "id": "waves-waveshell"
    },
    {
      "regex": "^iZOzone11",
      "id": "ozone-11"
    },
    {
      "regex": "^Ozone 11",
      "id": "ozone-11"
    },
    {
      "regex": "^Vienna Ensemble Pro",
      "id": "vienna-ensemble-pro"
