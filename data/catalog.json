{
  "_설명": "스캔 이름 → 사이트 항목 연결표. import_scan.py가 사용. 같은 제품의 여러 파일을 하나로 묶고, 표시 이름·제조사·종류의 기본값을 정한다.",
  "ignore": ["NativeAccess", "Native Access"],
  "patterns": [
    { "regex": "^WaveShell", "id": "waves-waveshell" },
    { "regex": "^iZOzone11", "id": "ozone-11" },
    { "regex": "^Ozone 11", "id": "ozone-11" },
    { "regex": "^Vienna Ensemble Pro", "id": "vienna-ensemble-pro" },
    { "regex": "^Microtonic", "id": "microtonic" },
    { "regex": "^Reaktor 6", "id": "reaktor-6" },
    { "regex": "^Synthesizer V Studio 2", "id": "synthesizer-v-studio-2" },
    { "regex": "^ACE Bridge", "id": "ace-studio-bridge" },
    { "regex": "(uaudio_610_a|UADx 610-A)", "id": "uadx-610-a" },
    { "regex": "(uaudio_610_b|UADx 610-B)", "id": "uadx-610-b" },
    { "regex": "(uaudio_teletronix_la-2a|UADx LA-2A)", "id": "uadx-la-2a" },
    { "regex": "(uaudio_pure_plate|UADx Pure Plate)", "id": "uadx-pure-plate" },
    { "regex": "(uaudio_showtime_amp|UADx Showtime 64)", "id": "uadx-showtime-64" },
    { "regex": "Abbey Road Two", "id": "spitfire-abbey-road-two" }
