      "id": "microtonic"
    },
    {
      "regex": "^Reaktor 6",
      "id": "reaktor-6"
    },
    {
      "regex": "^Synthesizer V Studio 2",
      "id": "synthesizer-v-studio-2"
    },
    {
      "regex": "^ACE Bridge",
      "id": "ace-studio-bridge"
    },
    {
      "regex": "(uaudio_610_a|UADx 610-A)",
      "id": "uadx-610-a"
    },
    {
      "regex": "(uaudio_610_b|UADx 610-B)",
      "id": "uadx-610-b"
    },
    {
      "regex": "(uaudio_teletronix_la-2a|UADx LA-2A)",
